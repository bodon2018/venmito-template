# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the pooler host. Remove the [ ] around the password -- they are
# placeholder markers, not part of the value.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Which people file wins when two disagree about the same id
PEOPLE_PRECEDENCE=["people.json","people.yml"]

# collapse_to_lowest | quarantine
DUPLICATE_POLICY=collapse_to_lowest
