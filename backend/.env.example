# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the pooler host. Remove the [ ] around the password -- they are
# placeholder markers, not part of the value.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Which people file wins when two disagree about the same id
PEOPLE_PRECEDENCE=["people.json","people.yml"]

# collapse_to_lowest | quarantine
DUPLICATE_POLICY=collapse_to_lowest

# Shared access codes, comma-separated. Anyone holding one can use the app.
# Leave empty to disable the gate (local development only).
ACCESS_CODES_RAW=CODE-ONE,CODE-TWO

# Optional signing secret for the access token; derived from the codes when unset.
SECRET_KEY=
